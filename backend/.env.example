USE_BIRDNET=true
MOCK_BIRDNET=false

# Bengaluru default — set to your balcony for a tighter species list
BIRDNET_LAT=12.9716
BIRDNET_LON=77.5946
# Place name for those coordinates, included when a clip is shared from the app
LOCATION_NAME=Bengaluru, Karnataka, India
BIRDNET_USE_GEO=true
BIRDNET_MIN_CONF=0.20

# Logged to history vs hero "Noticed" (lower = more sensitive)
MIN_CONFIDENCE=0.35

EVENT_COOLDOWN_SECONDS=300
# BirdNET uses ~3 s windows; shorter = faster response, less context
ANALYSIS_WINDOW_SECONDS=3

# --- JEV (Phase 5) ---
# rules = local cooldown/heuristics only
# llm = TypeSafe Jev decides surfacing (BirdNET species unchanged)
JEV_MODE=llm
JEV_SURFACE_THRESHOLD=0.55
TYPESAFE_API_KEY=
JEV_BASE_URL=
JEV_MODEL=jev-latest

# Supabase (optional). With both set, history goes to Postgres and clips (as MP3) to Storage.
# Run supabase/schema.sql in the SQL Editor first. Project Settings → API: URL + secret key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=recordings
